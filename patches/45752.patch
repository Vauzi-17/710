From 938ecf59eff599129301caebdec7375cf6f394ea Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Thu, 29 Oct 2026 16:02:44 +0100
Subject: [PATCH 6/6] ir3: Don't reuse GPRs for alias.tex groups on a7xx gen1

On a7xx gen1 alias.tex gives wrong results when the alias registers
are GPRs that the shader also uses, as happens when an alias group
reuses the GPRs of some of its sources. The blob only uses r40+ for
alias registers there.

Fixes "Dirt Rally 2" and many other games.

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h | 7 +++++++
 src/freedreno/common/freedreno_devices.py | 1 +
 src/freedreno/ir3/ir3_alias.c             | 5 +++++
 3 files changed, 13 insertions(+)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index 90a6bdcb7cf9..3ae8d14f151f 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -522,6 +522,13 @@ struct fd_dev_info {
        */
       bool early_preamble_branch_quirk;
 
+      /* On a7xx gen1 alias.tex gives wrong results when the alias registers
+       * are GPRs that the shader also uses, as happens when an alias group
+       * reuses the GPRs of some of its sources. The blob only uses r40+ for
+       * alias registers there.
+       */
+      bool alias_tex_no_gpr_reuse_quirk;
+
       /* Whether SUBPASS_FENCE can be used as a lighter-weight GMEM-only
        * UCHE invalidate and slice-local wait for by-region barriers.
        */
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 312e1f0499b0..20e930836a86 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -830,6 +830,7 @@ a7xx_gen1 = GPUProps(
         s2en_index_ignores_alias_tex_quirk = True,
         non_fs_descriptor_prefetch_quirk = True,
         early_preamble_branch_quirk = True,
+        alias_tex_no_gpr_reuse_quirk = True,
         QCTDD08407086 = True,
         QCTDD08517960 = True,
     )
diff --git a/src/freedreno/ir3/ir3_alias.c b/src/freedreno/ir3/ir3_alias.c
index 52f58a9ffac3..d7bc4a62d2f0 100644
--- a/src/freedreno/ir3/ir3_alias.c
+++ b/src/freedreno/ir3/ir3_alias.c
@@ -379,8 +379,13 @@ alloc_alias(struct alias_table_state *state, struct ir3_instruction *instr,
     */
    unsigned best_reg = INVALID_REG;
    unsigned best_num_reused = 0;
+   bool can_reuse =
+      !instr->block->shader->compiler->info->props.alias_tex_no_gpr_reuse_quirk;
 
    foreach_src_in_alias_group_n (alias, alias_n, instr, first_src_n) {
+      if (!can_reuse)
+         break;
+
       if (used_regs[alias_n] == INVALID_REG) {
          /* No (free) GPR is used by this alias. */
          continue;
