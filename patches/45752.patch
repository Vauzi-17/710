+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -4010,7 +4010,7 @@ tu_cmd_render_tiles(struct tu_cmd_buffer *cmd,
     */
    if (cmd->state.rp.read_only_input_attachments &&
        cmd->state.rp.input_attachment_read_barrier) {
-      tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_NONE,
+      tu_flush_for_access<CHIP>(cmd->device, &cmd->state.cache, TU_ACCESS_NONE,
                                 TU_ACCESS_UCHE_READ);
    }
 
@@ -5775,7 +5775,8 @@ tu_CmdBindPipeline(VkCommandBuffer commandBuffer,
 
 template <chip CHIP>
