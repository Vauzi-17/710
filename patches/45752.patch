From b0af69177f6a9f45f3fa273ffdba1fbadf965ce6 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Thu, 29 Oct 2026 15:26:44 +0100
Subject: [PATCH 5/6] ir3: Don't use early preamble with branches on a7xx gen1

VS + early preamble + control flow in early preamble caused rendering
corruptions when several draws with same pipeline ran back to back.
A WFI between the draws, or removing control flow from the preamble
fixed the issue. Proprietary driver doesn't control flow in early preamble.

Fixes at least "The Witcher 3" rendering.

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h |  5 +++++
 src/freedreno/common/freedreno_devices.py |  1 +
 src/freedreno/ir3/ir3_legalize.c          | 10 ++++++++++
 3 files changed, 16 insertions(+)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index b13e52cfc22b..90a6bdcb7cf9 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -517,6 +517,11 @@ struct fd_dev_info {
        */
       bool non_fs_descriptor_prefetch_quirk;
 
+      /* On a7xx gen1 VS + early preamble + control flow in early preamble caused
+       * rendering corruptions when several draws with same pipeline ran back to back.
+       */
+      bool early_preamble_branch_quirk;
+
       /* Whether SUBPASS_FENCE can be used as a lighter-weight GMEM-only
        * UCHE invalidate and slice-local wait for by-region barriers.
        */
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index bdb45148174e..312e1f0499b0 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -829,6 +829,7 @@ a7xx_gen1 = GPUProps(
         fsr_attachment_linear_quirk = True,
         s2en_index_ignores_alias_tex_quirk = True,
         non_fs_descriptor_prefetch_quirk = True,
+        early_preamble_branch_quirk = True,
         QCTDD08407086 = True,
         QCTDD08517960 = True,
     )
diff --git a/src/freedreno/ir3/ir3_legalize.c b/src/freedreno/ir3/ir3_legalize.c
index 8e8fe5e339d3..2634d87a0144 100644
--- a/src/freedreno/ir3/ir3_legalize.c
+++ b/src/freedreno/ir3/ir3_legalize.c
@@ -2522,6 +2522,7 @@ ir3_legalize(struct ir3 *ir, struct ir3_shader_variant *so, int *max_bary,
    bool gpr_in_preamble = false;
    bool pred_in_preamble = false;
    bool relative_in_preamble = false;
+   bool branch_in_preamble = false;
    bool in_preamble = start_block != ir3_start_block(ir);
    bool has_preamble = start_block != ir3_start_block(ir);
 
@@ -2564,6 +2565,11 @@ ir3_legalize(struct ir3 *ir, struct ir3_shader_variant *so, int *max_bary,
              !(instr->dsts[0]->flags & IR3_REG_UNIFORM)) {
             pred_in_preamble = true;
          }
+
+         if (in_preamble && is_flow(instr) && instr->opc != OPC_SHPS &&
+             instr->opc != OPC_GETONE && instr->opc != OPC_SHPE) {
+            branch_in_preamble = true;
+         }
       }
    }
 
@@ -2572,6 +2578,10 @@ ir3_legalize(struct ir3 *ir, struct ir3_shader_variant *so, int *max_bary,
       ir->compiler->info->props.has_early_preamble &&
       !(ir3_shader_debug & IR3_DBG_NOEARLYPREAMBLE);
 
+   if (branch_in_preamble && so->early_preamble &&
+       ir->compiler->info->props.early_preamble_branch_quirk)
+      so->early_preamble = false;
+
    if (relative_in_preamble && so->early_preamble &&
        IR3_QUIRK(ctx->compiler, QCTDD10789828_no_a0_ep))
       so->early_preamble = false;
