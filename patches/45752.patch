From 0815824e008ffb499c45f8be8b4f621237758610 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Mon, 26 Oct 2026 20:40:24 +0100
Subject: [PATCH 3/6] ir3: Don't alias the s2en texture/sampler index on a7xx
 gen1

On a7xx gen1 cat5 .s2en instruction ignores alias.tex for its bindless
texture/sampler index source.

Fixes on A725:
dEQP-VK.binding_model.descriptorset_random.*.unifindexed.*
dEQP-VK.binding_model.mutable_descriptor.*.index_push_constant.*
dEQP-VK.pipeline.fast_linked_library.descriptor_limits.fragment_shader.samplers_199

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h | 5 +++++
 src/freedreno/common/freedreno_devices.py | 2 +-
 src/freedreno/ir3/ir3_alias.c             | 6 ++++++
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index 7b21d3029ed3..d28353d65334 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -516,6 +516,11 @@ struct fd_dev_info {
        */
       bool has_subpass_fence;
 
+      /* On a7xx gen1 the bindless texture/sampler index of a cat5 .s2en
+       * instruction seems to ignore aliases.
+       */
+      bool s2en_index_ignores_alias_tex_quirk;
+
       /* On a750+ SUBPASS_FENCE also implicitly does CCU_RESOLVE_CLEAN */
       bool subpass_fence_cleans_resolve;
    } props;
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 949f9be16df2..a78bb51f92fd 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -826,8 +826,8 @@ a7xx_gen1 = GPUProps(
         supports_uav_ubwc = True,
         enable_tp_ubwc_flag_hint = True,
         reading_shading_rate_requires_smask_quirk = True,
-        s2en_index_ignores_alias_tex_quirk = True,
         fsr_attachment_linear_quirk = True,
+        s2en_index_ignores_alias_tex_quirk = True,
         QCTDD08407086 = True,
         QCTDD08517960 = True,
     )
diff --git a/src/freedreno/ir3/ir3_alias.c b/src/freedreno/ir3/ir3_alias.c
index 98037927cfeb..52f58a9ffac3 100644
--- a/src/freedreno/ir3/ir3_alias.c
+++ b/src/freedreno/ir3/ir3_alias.c
@@ -85,6 +85,12 @@ alias_srcs(struct ir3_instruction *instr, const struct ir3_compiler *compiler)
       struct ir3_register *src = old_srcs[src_n];
       bool can_alias = can_alias_src(src);
 
+      if (src_n == 0 && (instr->flags & IR3_INSTR_S2EN) &&
+          compiler->info->props.s2en_index_ignores_alias_tex_quirk) {
+         instr->srcs[instr->srcs_count++] = src;
+         continue;
+      }
+
       if (!can_alias || !can_alias_srcs_of_def(src)) {
          if (can_alias && num_aliases + 1 <= MAX_ALIASES) {
             src->flags |= (IR3_REG_FIRST_ALIAS | IR3_REG_ALIAS);
-- 
