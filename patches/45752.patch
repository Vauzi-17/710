-tu_flush_for_access(struct tu_cache_state *cache,
+tu_flush_for_access(struct tu_device *dev,
+                    struct tu_cache_state *cache,
                     enum tu_cmd_access_mask src_mask,
                     enum tu_cmd_access_mask dst_mask)
 {
@@ -5863,11 +5864,11 @@ tu_flush_for_access(struct tu_cache_state *cache,
    }
 
    if (dst_mask & TU_ACCESS_UCHE_READ_GMEM) {
-      /* On a7xx+, use SUBPASS_FENCE (SUBPASS_SLICE_FENCE on a8xx) which
-       * guarantees accesses for GMEM accesses through UCHE instead of
+      /* When available (A7XX gen2+), use SUBPASS_FENCE (SUBPASS_SLICE_FENCE on a8xx)
+       * which guarantees accesses for GMEM accesses through UCHE instead of
        * invalidating all of UCHE.
        */
-      if (CHIP >= A7XX) {
+      if (dev->physical_device->info->props.has_subpass_fence) {
          flush_bits |= TU_CMD_FLAG_CACHE_INVALIDATE_GMEM;
       } else {
          flush_bits |= TU_CMD_FLAG_CACHE_INVALIDATE;
@@ -6272,7 +6273,8 @@ vk2tu_dst_stage(struct tu_device *dev,
 
 template <chip CHIP>
 static void
-tu_flush_for_stage(struct tu_cache_state *cache,
+tu_flush_for_stage(struct tu_device *dev,
+                   struct tu_cache_state *cache,
                    enum tu_stage src_stage, enum tu_stage dst_stage,
                    bool by_region)
 {
@@ -6302,7 +6304,7 @@ tu_flush_for_stage(struct tu_cache_state *cache,
                cache->pending_flush_bits |= TU_CMD_FLAG_WAIT_FOR_ME;
          }
       } else {
-         if (CHIP >= A7XX && by_region)
+         if (by_region && dev->physical_device->info->props.has_subpass_fence)
             cache->flush_bits |= TU_CMD_FLAG_SUBPASS_SLICE_FENCE;
          else
             cache->flush_bits |= TU_CMD_FLAG_WAIT_FOR_IDLE;
@@ -6769,11 +6771,12 @@ tu_subpass_barrier(struct tu_cmd_buffer *cmd_buffer,
          dst_flags |= TU_ACCESS_UCHE_READ;
    }
 
-   tu_flush_for_access<CHIP>(cache, src_flags, dst_flags);
+   tu_flush_for_access<CHIP>(cmd_buffer->device, cache, src_flags, dst_flags);
 
    enum tu_stage src_stage = vk2tu_src_stage(cmd_buffer->device, src_stage_vk);
    enum tu_stage dst_stage = vk2tu_dst_stage(cmd_buffer->device, dst_stage_vk);
-   tu_flush_for_stage<CHIP>(cache, src_stage, dst_stage, !barrier->non_fb_local);
+   tu_flush_for_stage<CHIP>(cmd_buffer->device, cache, src_stage, dst_stage,
+                            !barrier->non_fb_local);
 }
 
