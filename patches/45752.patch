From 68cf06cd8e6fcce82ed7cf4a7d77c3f3f582057f Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Mon, 26 Oct 2026 20:49:58 +0100
Subject: [PATCH 1/6] tu: Always use linear fragment shading rate attachments
 on a7xx gen1

A725 reads the fragment shading rate attachment as linear regardless of
GRAS_QUALITY_BUFFER_INFO.TILE_MODE. The proprietary driver also uses linear
attachments there.

Fixes on A725:
dEQP-VK.fragment_shading_rate.*.attachment.*

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h | 5 +++++
 src/freedreno/common/freedreno_devices.py | 3 ++-
 src/freedreno/vulkan/tu_image.cc          | 3 ++-
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index 47f47f930a5d..6fc70e8b91eb 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -506,6 +506,11 @@ struct fd_dev_info {
        */
       bool prefetch_sam_helpers_quirk;
 
+      /* On a7xx gen1 the fragment shading rate attachment seems to always be
+       * read as linear, tiled attachments give wrong rates.
+       */
+      bool fsr_attachment_linear_quirk;
+
       /* On a750+ SUBPASS_FENCE also implicitly does CCU_RESOLVE_CLEAN */
       bool subpass_fence_cleans_resolve;
    } props;
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 47e70304d5ac..0e1b07237f53 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -826,7 +826,8 @@ a7xx_gen1 = GPUProps(
         supports_uav_ubwc = True,
         enable_tp_ubwc_flag_hint = True,
         reading_shading_rate_requires_smask_quirk = True,
-        QCTDD08049535 = True,
+        s2en_index_ignores_alias_tex_quirk = True,
+        fsr_attachment_linear_quirk = True,
         QCTDD08407086 = True,
         QCTDD08517960 = True,
     )
diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
index 478a63b71d44..3fa65710ee9b 100644
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -580,7 +580,8 @@ tu_image_init(struct tu_device *device, struct tu_image *image,
    /* Some kind of HW limitation. */
    if (pCreateInfo->usage &
           VK_IMAGE_USAGE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR &&
-       image->vk.extent.width < 16) {
+       (image->vk.extent.width < 16 ||
+        device->physical_device->info->props.fsr_attachment_linear_quirk)) {
       force_linear_tile = true;
    }
 
-- 
