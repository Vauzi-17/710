From b6fa4254ec594bff464188fbc1631399f3ab5867 Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Thu, 29 Oct 2026 13:50:10 +0100
Subject: [PATCH 4/6] ir3: Don't prefetch descriptors outside of FS on a7xx
 gen1

On A725 a dummy prefetch sam.s2en in a vertex shader preamble may cause
intermittent GPU faults. Dropping only the non-FS sam prefetches fixes it,
but the blob doesn't emit any descriptor prefetches (sam, resinfo, ldc)
in VS or CS preambles on A725, so don't prefetch descriptors outside of FS
at all.

Fixes hang in "God Of War".

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h | 6 ++++++
 src/freedreno/common/freedreno_devices.py | 1 +
 src/freedreno/ir3/ir3_nir.c               | 2 ++
 3 files changed, 9 insertions(+)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index d28353d65334..b13e52cfc22b 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -511,6 +511,12 @@ struct fd_dev_info {
        */
       bool fsr_attachment_linear_quirk;
 
+      /* On a7xx gen1 a dummy prefetch sam in a non-fragment shader preamble
+       * may cause GPU faults. The blob doesn't emit any descriptor prefetches
+       * outside of FS.
+       */
+      bool non_fs_descriptor_prefetch_quirk;
+
       /* Whether SUBPASS_FENCE can be used as a lighter-weight GMEM-only
        * UCHE invalidate and slice-local wait for by-region barriers.
        */
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index a78bb51f92fd..bdb45148174e 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -828,6 +828,7 @@ a7xx_gen1 = GPUProps(
         reading_shading_rate_requires_smask_quirk = True,
         fsr_attachment_linear_quirk = True,
         s2en_index_ignores_alias_tex_quirk = True,
+        non_fs_descriptor_prefetch_quirk = True,
         QCTDD08407086 = True,
         QCTDD08517960 = True,
     )
diff --git a/src/freedreno/ir3/ir3_nir.c b/src/freedreno/ir3/ir3_nir.c
index 6e6f09e7b08d..b0cbc3fff84a 100644
