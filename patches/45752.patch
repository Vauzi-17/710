From dedd816c9f8ed7fd62ec488a06a773d876cac99c Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Mon, 26 Oct 2026 23:04:11 +0100
Subject: [PATCH 2/6] tu: Use SUBPASS_FENCE only on a7xx gen2+

On A725 (a7xx gen1) input attachment reads after a by-region barrier
inside a binned render pass see stale data when GMEM is invalidated only
via SUBPASS_FENCE, failing rasterization_order_attachment_access
*.multi_draw_barriers in GMEM mode.

The blob never emits SUBPASS_FENCE on a7xx gen1.

Assisted-by: LLM
Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 src/freedreno/common/freedreno_dev_info.h |  5 +++
 src/freedreno/common/freedreno_devices.py |  2 ++
 src/freedreno/vulkan/tu_clear_blit.cc     | 12 +++----
 src/freedreno/vulkan/tu_cmd_buffer.cc     | 44 +++++++++++++----------
 src/freedreno/vulkan/tu_cmd_buffer.h      |  3 +-
 src/freedreno/vulkan/tu_query_pool.cc     |  2 +-
 6 files changed, 42 insertions(+), 26 deletions(-)

diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index 6fc70e8b91eb..7b21d3029ed3 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -511,6 +511,11 @@ struct fd_dev_info {
        */
       bool fsr_attachment_linear_quirk;
 
+      /* Whether SUBPASS_FENCE can be used as a lighter-weight GMEM-only
+       * UCHE invalidate and slice-local wait for by-region barriers.
+       */
+      bool has_subpass_fence;
+
       /* On a750+ SUBPASS_FENCE also implicitly does CCU_RESOLVE_CLEAN */
       bool subpass_fence_cleans_resolve;
    } props;
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 0e1b07237f53..949f9be16df2 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -847,6 +847,7 @@ a7xx_gen2 = GPUProps(
         has_image_processing = True,
         has_64b_image_atomics = True,
         has_implicit_fragface_fragcoord_ij_linear = True,
+        has_subpass_fence = True,
 
         QCTDD08049535 = True,
         QCTDD08901551 = True,
@@ -881,6 +882,7 @@ a7xx_gen3 = GPUProps(
         max_draw_states = 64,
         has_64b_image_atomics = True,
         has_implicit_fragface_fragcoord_ij_linear = True,
+        has_subpass_fence = True,
         subpass_fence_cleans_resolve = True,
 
         QCTDD08901551 = False,
diff --git a/src/freedreno/vulkan/tu_clear_blit.cc b/src/freedreno/vulkan/tu_clear_blit.cc
index 199c7d13ea63..bee73210c295 100644
--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -2448,7 +2448,7 @@ handle_buffer_unaligned_store(struct tu_cmd_buffer *cmd,
       return;
 
    if ((dst_va & 63) || (size & 63)) {
-      tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_NONE,
+      tu_flush_for_access<CHIP>(cmd->device, &cmd->state.cache, TU_ACCESS_NONE,
                                 TU_ACCESS_CCU_COLOR_INCOHERENT_WRITE);
       /* Wait for invalidations to land. */
       cmd->state.cache.flush_bits |= TU_CMD_FLAG_WAIT_FOR_IDLE;
@@ -2463,7 +2463,7 @@ after_buffer_unaligned_buffer_store(struct tu_cmd_buffer *cmd,
                                     bool unaligned_store)
 {
    if (unaligned_store) {
-      tu_flush_for_access<CHIP>(&cmd->state.cache,
+      tu_flush_for_access<CHIP>(cmd->device, &cmd->state.cache,
                                 TU_ACCESS_CCU_COLOR_INCOHERENT_WRITE,
                                 TU_ACCESS_NONE);
    }
@@ -5021,7 +5021,7 @@ tu_emit_clear_gmem_attachment(struct tu_cmd_buffer *cmd,
       }
    }
 
-   tu_flush_for_access<CHIP>(&cmd->state.renderpass_cache,
+   tu_flush_for_access<CHIP>(cmd->device, &cmd->state.renderpass_cache,
                              TU_ACCESS_BLIT_WRITE_GMEM, TU_ACCESS_NONE);
 
    trace_end_gmem_clear(&cmd->rp_trace, cs);
@@ -5291,7 +5291,7 @@ tu_clear_attachments_generic(struct tu_cmd_buffer *cmd,
 
    tu_emit_resolve_group<A7XX>(cmd, cs, &resolve_group);
 
-   TU_CALLX(cmd->device, tu_flush_for_access)(&cmd->state.renderpass_cache, TU_ACCESS_BLIT_WRITE_GMEM, TU_ACCESS_NONE);
+   TU_CALLX(cmd->device, tu_flush_for_access)(cmd->device, &cmd->state.renderpass_cache, TU_ACCESS_BLIT_WRITE_GMEM, TU_ACCESS_NONE);
 }
 
 template <chip CHIP>
@@ -5516,7 +5516,7 @@ tu7_generic_clear_attachment(struct tu_cmd_buffer *cmd,
    }
 
    TU_CALLX(cmd->device, tu_flush_for_access)(
-      &cmd->state.renderpass_cache, TU_ACCESS_BLIT_WRITE_GMEM, TU_ACCESS_NONE);
+      cmd->device, &cmd->state.renderpass_cache, TU_ACCESS_BLIT_WRITE_GMEM, TU_ACCESS_NONE);
 
    trace_end_generic_clear(&cmd->rp_trace, cs);
 }
@@ -5713,7 +5713,7 @@ tu_emit_blit(struct tu_cmd_buffer *cmd,
       event_blit_run<CHIP>(cmd, cs, attachment, fdl_view, i, separate_stencil);
    }
 
-   tu_flush_for_access<CHIP>(&cmd->state.cache, TU_ACCESS_BLIT_WRITE_GMEM,
+   tu_flush_for_access<CHIP>(cmd->device, &cmd->state.cache, TU_ACCESS_BLIT_WRITE_GMEM,
                              TU_ACCESS_NONE);
 }
 
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
