          n = ir3_NOP(&build);
@@ -1626,17 +1626,6 @@ dbg_expand_rpt(struct ir3 *ir)
    }
 }
 
-bool
-ir3_prefetch_sam_needs_helpers(struct ir3_compiler *compiler,
