From ec5a9a6d86133c45d3e42bd3583ba3ad9572c3a2 Mon Sep 17 00:00:00 2001
From: Dhruv Mark Collins <mark@igalia.com>
Date: Fri, 16 Oct 2026 10:26:55 +0000
Subject: [PATCH] ir3: Remove texture descriptor prefetch support

Nothing emits prefetch_sam_ir3 or prefetch_tex_ir3 now that only UBO
descriptors are prefetched. Remove them along with the dummy sam handling
in alias and legalize, including prefetch_sam_helpers_quirk, which only
applied to the dummy sam.s2en.

Signed-off-by: Dhruv Mark Collins <mark@igalia.com>
Generated-by: LLM
---
 src/compiler/nir/nir_intrinsics.py        |  4 +--
 src/freedreno/common/freedreno_dev_info.h |  7 -----
 src/freedreno/common/freedreno_devices.py |  2 --
 src/freedreno/ir3/ir3.h                   | 13 ++-------
 src/freedreno/ir3/ir3_alias.c             |  3 --
 src/freedreno/ir3/ir3_compiler_nir.c      | 32 ---------------------
 src/freedreno/ir3/ir3_legalize.c          | 35 ++---------------------
 7 files changed, 6 insertions(+), 90 deletions(-)

diff --git a/src/compiler/nir/nir_intrinsics.py b/src/compiler/nir/nir_intrinsics.py
index dd46072e5c34..429aafb636ac 100644
--- a/src/compiler/nir/nir_intrinsics.py
+++ b/src/compiler/nir/nir_intrinsics.py
@@ -1751,9 +1751,7 @@ intrinsic("shuffle_up_uniform_ir3", src_comp=[0, 1], dest_comp=0,
 intrinsic("shuffle_down_uniform_ir3", src_comp=[0, 1], dest_comp=0,
           bit_sizes=src0, flags=[CAN_ELIMINATE])
 
-# IR3-specific intrinsics for prefetching descriptors in preambles.
-intrinsic("prefetch_sam_ir3", [1, 1], indices=[ACCESS], flags=[CAN_REORDER])
-intrinsic("prefetch_tex_ir3", [1], indices=[ACCESS], flags=[CAN_REORDER])
+# IR3-specific intrinsic for prefetching UBO descriptors in preambles.
 intrinsic("prefetch_ubo_ir3", [1], indices=[ACCESS], flags=[CAN_REORDER])
 
 intrinsic("resbase_ir3", src_comp=[1], dest_comp=2, flags=[CAN_ELIMINATE, CAN_REORDER])
diff --git a/src/freedreno/common/freedreno_dev_info.h b/src/freedreno/common/freedreno_dev_info.h
index b881e4f8b8d3..f2a487c597d9 100644
--- a/src/freedreno/common/freedreno_dev_info.h
+++ b/src/freedreno/common/freedreno_dev_info.h
@@ -483,13 +483,6 @@ struct fd_dev_info {
       uint32_t max_texel_buffer_range_elements;
       uint32_t max_storage_buffer_range_bytes;
 
-      /* There seems to be a HW bug where a dummy prefetch sam.s2en always
-       * reads its src2 from fiber 0. This may cause faults when fiber 0 is a
-       * helper and helpers are disabled. We work around this by keeping
-       * helpers enabled until after such sam.s2en.
-       */
-      bool prefetch_sam_helpers_quirk;
-
       /* On a750+ SUBPASS_FENCE also implicitly does CCU_RESOLVE_CLEAN */
       bool subpass_fence_cleans_resolve;
    } props;
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index 7ab1706fd815..06ece3d90a7c 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -810,8 +810,6 @@ a7xx_base = GPUProps(
         max_texel_buffer_range_elements = 1 << 27,
         max_storage_buffer_range_bytes = 1 << 27,
 
-        prefetch_sam_helpers_quirk = True,
-
         QCTDD10204462 = True,
         QCTDD11147232 = True,
         QCTDD11183148 = True,
diff --git a/src/freedreno/ir3/ir3.h b/src/freedreno/ir3/ir3.h
index be5915e20f2b..91b08d5e1b38 100644
--- a/src/freedreno/ir3/ir3.h
+++ b/src/freedreno/ir3/ir3.h
@@ -190,7 +190,7 @@ typedef enum ir3_register_flags {
    IR3_REG_FIRST_ALIAS = BIT(22),
 
    /* Set for registers that should be ignored by all passes. For example, the
-    * dummy src and dst of prefetch sam/ldc/resinfo.
+    * dummy dst of a prefetch ldc.
     */
    IR3_REG_DUMMY = BIT(23),
 
@@ -3085,7 +3085,7 @@ ir3_SAM(struct ir3_builder *build, opc_t opc, type_t type, unsigned wrmask,
    if (flags & IR3_INSTR_S2EN) {
       nreg++;
    }
-   if (src0 || opc == OPC_SAM) {
+   if (src0) {
       nreg++;
    }
    if (src1) {
@@ -3103,12 +3103,6 @@ ir3_SAM(struct ir3_builder *build, opc_t opc, type_t type, unsigned wrmask,
    }
    if (src0) {
       __ssa_src(sam, src0, 0);
-   } else if (opc == OPC_SAM) {
-      /* Create a dummy shared source for the coordinate, for the prefetch
-       * case. It needs to be shared so that we don't accidentally disable early
-       * preamble, and this is what the blob does.
-       */
-      ir3_src_create(sam, regid(48, 0), IR3_REG_SHARED | IR3_REG_DUMMY);
    }
    if (src1) {
       __ssa_src(sam, src1, 0);
@@ -3443,7 +3437,4 @@ unsigned ir3_required_delay(struct ir3_legalize_state *state,
                             struct ir3_compiler *compiler,
                             struct ir3_instruction *instr);
 
-bool ir3_prefetch_sam_needs_helpers(struct ir3_compiler *compiler,
-                                    struct ir3_instruction *sam);
-
 #endif /* IR3_H_ */
diff --git a/src/freedreno/ir3/ir3_alias.c b/src/freedreno/ir3/ir3_alias.c
index 5e925daf2671..19f3f7dd4634 100644
--- a/src/freedreno/ir3/ir3_alias.c
+++ b/src/freedreno/ir3/ir3_alias.c
@@ -15,9 +15,6 @@ supports_alias_srcs(struct ir3_instruction *instr)
       return false;
    if (is_tex_shuffle(instr))
       return false;
-   /* Descriptor prefetches don't support alias.tex. */
-   if (instr->opc == OPC_SAM && has_dummy_dst(instr))
-      return false;
    /* Seems to not always work properly. Blob disables it as well. */
    if (instr->opc == OPC_ISAM && (instr->flags & IR3_INSTR_IMM_OFFSET))
       return false;
